            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{"
        },
        "url": "{{baseUrl}}/api/books"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
